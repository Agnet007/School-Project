{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school.example/schemas/blocks/block-v1.schema.json",
  "title": "Lesson block v1",
  "type": "object",
  "required": ["blockId", "blockType", "blockSchemaVersion", "position", "configuration"],
  "properties": {
    "blockId": { "type": "string", "format": "uuid" },
    "blockType": { "enum": ["HEADING", "RICH_TEXT", "RULE", "IMAGE", "FORMULA", "CHART", "MULTIPLE_CHOICE", "NUMERIC_ANSWER", "TEXT_ANSWER", "SIMULATION", "WORKSPACE_LAUNCHER"] },
    "blockSchemaVersion": { "const": 1 },
    "position": { "type": "integer", "minimum": 0 },
    "configuration": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "blockType": { "const": "HEADING" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/heading" } } } },
    { "if": { "properties": { "blockType": { "const": "RICH_TEXT" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/richText" } } } },
    { "if": { "properties": { "blockType": { "const": "RULE" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/rule" } } } },
    { "if": { "properties": { "blockType": { "const": "IMAGE" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/image" } } } },
    { "if": { "properties": { "blockType": { "const": "FORMULA" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/formula" } } } },
    { "if": { "properties": { "blockType": { "const": "CHART" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/chart" } } } },
    { "if": { "properties": { "blockType": { "const": "MULTIPLE_CHOICE" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/multipleChoice" } } } },
    { "if": { "properties": { "blockType": { "const": "NUMERIC_ANSWER" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/numericAnswer" } } } },
    { "if": { "properties": { "blockType": { "const": "TEXT_ANSWER" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/textAnswer" } } } },
    { "if": { "properties": { "blockType": { "const": "SIMULATION" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/simulation" } } } },
    { "if": { "properties": { "blockType": { "const": "WORKSPACE_LAUNCHER" } } }, "then": { "properties": { "configuration": { "$ref": "#/$defs/workspaceLauncher" } } } }
  ],
  "$defs": {
    "heading": { "type": "object", "required": ["text", "level"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 500 }, "level": { "type": "integer", "minimum": 1, "maximum": 6 } }, "additionalProperties": false },
    "span": { "type": "object", "required": ["text", "bold", "italic", "inlineCode"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "^[^<>]*$" }, "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "inlineCode": { "type": "boolean" } }, "additionalProperties": false },
    "richElement": { "type": "object", "required": ["kind", "spans", "items"], "properties": { "kind": { "enum": ["paragraph", "unordered-list", "ordered-list"] }, "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } }, "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/span" } } } }, "additionalProperties": false },
    "richText": { "type": "object", "required": ["content"], "properties": { "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/richElement" } } }, "additionalProperties": false },
    "rule": { "type": "object", "maxProperties": 0, "additionalProperties": false },
    "image": { "type": "object", "required": ["url", "alt", "caption"], "properties": { "url": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(https?://|/assets/)" }, "alt": { "type": "string", "minLength": 1, "maxLength": 500 }, "caption": { "type": "string", "maxLength": 1000 } }, "additionalProperties": false },
    "formula": { "type": "object", "required": ["expression", "displayMode"], "properties": { "expression": { "type": "string", "minLength": 1, "maxLength": 2000 }, "displayMode": { "type": "boolean" } }, "additionalProperties": false },
    "point": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": false },
    "dataset": { "type": "object", "required": ["label", "color", "points"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 200 }, "color": { "type": "string", "maxLength": 50 }, "points": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/point" } } }, "additionalProperties": false },
    "chart": { "type": "object", "required": ["chartType", "title", "xAxisLabel", "yAxisLabel", "datasets", "tooltip"], "properties": { "chartType": { "enum": ["line", "bar", "scatter"] }, "title": { "type": "string", "maxLength": 500 }, "xAxisLabel": { "type": "string", "maxLength": 200 }, "yAxisLabel": { "type": "string", "maxLength": 200 }, "datasets": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/dataset" } }, "tooltip": { "type": "boolean" } }, "additionalProperties": false },
    "multipleChoice": { "type": "object", "required": ["prompt", "options", "allowMultiple"], "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }, "options": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "allowMultiple": { "type": "boolean" } }, "additionalProperties": false },
    "numericAnswer": { "type": "object", "required": ["prompt", "placeholder"], "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }, "placeholder": { "type": "string", "maxLength": 200 } }, "additionalProperties": false },
    "textAnswer": { "type": "object", "required": ["prompt", "multiline"], "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }, "multiline": { "type": "boolean" } }, "additionalProperties": false },
    "simulation": { "type": "object", "required": ["pluginId", "message"], "properties": { "pluginId": { "type": "string", "minLength": 1, "maxLength": 200 }, "message": { "type": "string", "maxLength": 1000 } }, "additionalProperties": false },
    "workspaceLauncher": { "type": "object", "required": ["label", "documentType"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 200 }, "documentType": { "enum": ["NOTE", "DRAWING_BOARD", "GRAPH_BOARD", "FORMULA_SHEET"] } }, "additionalProperties": false }
  }
}